msgid "Welcome to Celenn OS"
msgstr "Bienvenue dans Celenn OS"

msgid "Accessibility"
msgstr "Accessibilité"

msgid "Screen reader: Super + Alt + S\nZoom: Super + = and Super + -"
msgstr "Lecteur d’écran : Super + Alt + S\nZoom : Super + = et Super + -"

msgid "Settings"
msgstr "Paramètres"

msgid "First steps"
msgstr "Premiers pas"

msgid "Open COSMIC Store"
msgstr "Ouvrir COSMIC Store"

