msgid "Parental controls"
msgstr "Control parental"

msgid "Choose how long and when your children can use this computer."
msgstr "Elige cuánto tiempo y cuándo pueden usar tus hijos este ordenador."

msgid "Child accounts"
msgstr "Cuentas infantiles"

msgid "Other accounts"
msgstr "Otras cuentas"

msgid "Administrator · no limits"
msgstr "Administrador · sin límites"

msgid "Standard account · no limits"
msgstr "Cuenta estándar · sin límites"

msgid "This is a child"
msgstr "Es un niño"

msgid "Picture"
msgstr "Imagen"

msgid "No limits"
msgstr "Sin límites"

