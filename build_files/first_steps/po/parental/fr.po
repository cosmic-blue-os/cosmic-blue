msgstr "{} applications autorisées"

msgid "{} applications blocked"
msgstr "{} applications bloquées"

msgid "Today"
msgstr "Aujourd’hui"

msgid "Most used applications"
msgstr "Applications les plus utilisées"

msgid "Extra time"
msgstr "Temps en plus"

msgid "Bedtime included, until tomorrow morning"
msgstr "Heure du coucher comprise, jusqu’à demain matin"

msgid "The session closes in {}."
msgstr "La session se ferme dans {}."

msgid "The session will close at {new} instead of {old}."
msgstr "La session se fermera à {new} au lieu de {old}."

msgid "The session will close at {}."
msgstr "La session se fermera à {}."

msgid "No limit until tomorrow at {}."
msgstr "Plus de limite jusqu’à demain {}."

msgid "No limit for the rest of the day."
msgstr "Plus de limite pour le reste de la journée."

