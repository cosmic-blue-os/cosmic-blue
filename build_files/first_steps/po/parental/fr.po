msgstr "Enlever la limite"

msgid "At most 4 h. For more, turn on No limit today."
msgstr "4 h au maximum. Pour plus, active Sans limite aujourd’hui."

msgid "Keep to bedtime"
msgstr "Respecter l’heure du coucher"

msgid "The session closes at {} all the same."
msgstr "La session se ferme à {} quand même."

msgid "Bedtime ({}) does not apply to this time."
msgstr "L’heure du coucher ({}) ne s’applique pas à ce temps."

