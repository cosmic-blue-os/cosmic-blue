msgstr "Les applications installées plus tard sont bloquées jusqu’à ce que vous les cochiez."

msgid "{} is not allowed"
msgstr "L’application {} n’est pas autorisée"

msgid "A parent must allow it first in Parental controls."
msgstr "Un parent doit d’abord l’autoriser dans le Contrôle parental."

msgid "Program blocked"
msgstr "Programme bloqué"

msgid "«{}» cannot run on this account: downloaded programs are not allowed."
msgstr "« {} » ne peut pas se lancer sur ce compte : les programmes téléchargés ne sont pas autorisés."

