[Desktop Entry]
Type=Application
Name=Updates
Name[fr]=Mises à jour
Name[de]=Updates
Name[es]=Actualizaciones
Name[it]=Aggiornamenti
Name[pt_BR]=Atualizações
Comment=See the system version, check for updates or go back to the previous version
Comment[fr]=Voir la version du système, vérifier les mises à jour ou revenir à la version précédente
Comment[de]=Systemversion anzeigen, nach Updates suchen oder zur vorherigen Version zurückkehren
Comment[es]=Ver la versión del sistema, buscar actualizaciones o volver a la versión anterior
Comment[it]=Vedere la versione del sistema, cercare aggiornamenti o tornare alla versione precedente
Comment[pt_BR]=Ver a versão do sistema, procurar atualizações ou voltar para a versão anterior
Keywords=cosmic-blue;Update;Upgrade;Rollback;Version;System;
Keywords[fr]=cosmic-blue;Mise à jour;Retour arrière;Version;Système;
Keywords[de]=cosmic-blue;Update;Aktualisierung;Zurück;Version;System;
Keywords[es]=cosmic-blue;Actualización;Volver;Versión;Sistema;
Keywords[it]=cosmic-blue;Aggiornamento;Ripristino;Versione;Sistema;
Keywords[pt_BR]=cosmic-blue;Atualização;Voltar;Versão;Sistema;
Icon=cosmic-blue-update
Exec=/usr/libexec/cosmic-blue-tools --updates
Terminal=false
StartupNotify=true
Categories=System;Settings;
